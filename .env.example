# 환경 변수 목록과 기본값.
# 모든 값에 기본값이 있으므로 이 파일 없이도 동작한다.
# 로컬에서 값을 바꾸려면 이 파일을 .env로 복사해 수정한다 (.env는 커밋하지 않는다).

# 로그 레벨: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# 로그 형식: json (운영, 로그 수집기용), text (로컬 개발용)
LOG_FORMAT=json

# DB 접속 정보. 기본값은 로컬 개발용이며 compose와 운영 환경에서 덮어쓴다.
DATABASE_URL=postgresql+psycopg://registry:registry@localhost:5432/registry
# 커넥션 풀: Pod당 최대 연결 수 = DB_POOL_SIZE + DB_MAX_OVERFLOW (ADR 0002)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# 커넥션을 기다리는 최대 시간(초). 넘으면 503과 Retry-After로 빠르게 실패한다.
DB_POOL_TIMEOUT=5
# DB 접속 시도 최대 시간(초)
DB_CONNECT_TIMEOUT=5

# --- 테스트 전용 (pytest가 읽는다, 앱은 읽지 않는다) ---
# 통합 테스트 DB. 이름이 _test로 끝나야 한다 (ADR 0004).
# 지정하지 않으면 localhost:${DB_PORT:-5432}/registry_test를 쓴다.
# TEST_DATABASE_URL=postgresql+psycopg://registry:registry@localhost:5432/registry_test
