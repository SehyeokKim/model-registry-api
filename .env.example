# 환경 변수 목록과 기본값.
# 모든 값에 기본값이 있으므로 이 파일 없이도 동작한다 (`docker compose up -d`).
# 로컬에서 값을 바꾸려면 이 파일을 .env로 복사해 수정한다 (.env는 커밋하지 않는다).

# --- 애플리케이션 (API, migrate 서비스) ---
# 로그 레벨: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# 로그 형식: json (운영, 로그 수집기용), text (로컬 개발용)
LOG_FORMAT=json

# DB 접속 정보. compose에서는 POSTGRES_* 값으로 자동 구성되므로 호스트에서 직접 실행할 때만 쓴다.
DATABASE_URL=postgresql+psycopg://registry:registry@localhost:5432/registry
# 커넥션 풀: Pod당 최대 연결 수 = DB_POOL_SIZE + DB_MAX_OVERFLOW (ADR 0002)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# 커넥션을 기다리는 최대 시간(초). 넘으면 503과 Retry-After로 빠르게 실패한다.
DB_POOL_TIMEOUT=5
# DB 접속 시도 최대 시간(초)
DB_CONNECT_TIMEOUT=5

# 마이그레이션 후 데모 조직과 사용자를 넣을지 여부. 운영에서는 false.
SEED_DEMO_DATA=true

# 삭제된 모델을 복원할 수 있는 기간(일). purge_at = deleted_at + 이 기간
MODEL_RESTORE_WINDOW_DAYS=30

# 영구 삭제 커맨드(scripts.purge_expired_models)가 한 트랜잭션에서 지우는 최대 모델 수.
# 트랜잭션을 짧게 끊어 잠금 시간과 WAL 급증을 줄인다 (ADR 0005).
PURGE_BATCH_SIZE=500

# --- compose 전용 ---
# DB 계정. 기본값은 로컬 실행용이다.
POSTGRES_USER=registry
POSTGRES_PASSWORD=registry
POSTGRES_DB=registry
# 호스트에 노출할 API 포트 (컨테이너 내부 포트는 8000 고정)
API_PORT=8000
# compose.dev.yaml이 호스트에 노출할 DB 포트. 테스트도 이 값으로 테스트 DB에 접속한다.
DB_PORT=5432

# --- 테스트 전용 (pytest가 읽는다, 앱은 읽지 않는다) ---
# 통합 테스트 DB. 이름이 _test로 끝나야 한다 (ADR 0004).
# 지정하지 않으면 localhost:${DB_PORT:-5432}/registry_test를 쓴다.
# TEST_DATABASE_URL=postgresql+psycopg://registry:registry@localhost:5432/registry_test
